module fir_filter(
    input clk,
    input rst,
    input signed [15:0] x_in,
    output reg signed [31:0] y_out
);

    // FIR Coefficients
    parameter signed h0 = 1;
    parameter signed h1 = 6;
    parameter signed h2 = 21;
    parameter signed h3 = 36;
    parameter signed h4 = 36;
    parameter signed h5 = 21;
    parameter signed h6 = 6;
    parameter signed h7 = 1;

    // Shift Register
    reg signed [15:0] shift_reg [0:7];

    integer i;

    always @(posedge clk)
    begin
        if (rst)
        begin
            for(i=0; i<8; i=i+1)
                shift_reg[i] <= 16'd0;

            y_out <= 32'd0;
        end

        else
        begin
            // Shift samples
            shift_reg[7] <= shift_reg[6];
            shift_reg[6] <= shift_reg[5];
            shift_reg[5] <= shift_reg[4];
            shift_reg[4] <= shift_reg[3];
            shift_reg[3] <= shift_reg[2];
            shift_reg[2] <= shift_reg[1];
            shift_reg[1] <= shift_reg[0];
            shift_reg[0] <= x_in;

            // FIR Output
            y_out <=
                shift_reg[0]*h0 +
                shift_reg[1]*h1 +
                shift_reg[2]*h2 +
                shift_reg[3]*h3 +
                shift_reg[4]*h4 +
                shift_reg[5]*h5 +
                shift_reg[6]*h6 +
                shift_reg[7]*h7;
        end
    end

endmodule
