module fir_filter_tb;

    reg clk;
    reg rst;
    reg signed [15:0] x_in;

    wire signed [31:0] y_out;

    fir_filter DUT(
        .clk(clk),
        .rst(rst),
        .x_in(x_in),
        .y_out(y_out)
    );

    // Clock Generation
    always #5 clk = ~clk;

    initial
    begin
        clk = 0;
        rst = 1;
        x_in = 0;

        #20;
        rst = 0;

        // Apply input sequence
        #10 x_in = 10;
        #10 x_in = 20;
        #10 x_in = 30;
        #10 x_in = 40;
        #10 x_in = 50;
        #10 x_in = 60;
        #10 x_in = 70;
        #10 x_in = 80;
        #10 x_in = 90;
        #10 x_in = 100;

        // Stop applying samples
        #10 x_in = 0;

        #200;
        $finish;
    end

    // Display Output
    initial
    begin
        $display("Time\tInput\tOutput");
        $monitor("%0t\t%d\t%d", $time, x_in, y_out);
    end

endmodule
